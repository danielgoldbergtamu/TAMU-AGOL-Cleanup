# This repository is public. Organization data never belongs in it.
# tools/leak_check.py enforces the same rule at commit time (git config core.hooksPath .githooks).

# Reports hold real users, items and Entra lookups. Everything in reports/ except its README.
reports/*
!reports/README.md

# Private records and local data, kept beside the code but never committed
private/
data/

# Data file types, anywhere, except synthetic test fixtures
*.csv
*.xlsx
*.xls
*.parquet
*.duckdb
*.bak
!tests/fixtures/**

# Secrets
.env

# Email templates with local wording
/*EmailTemplate.txt

# Editor and Python clutter
.vscode/
__pycache__/
*.pyc
