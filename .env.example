# This is an example environment variable file. Copy this to a new file named ".env" and fill in the appropriate values for your environment. Do not commit the .env file to version control, as it may contain sensitive information such as database connection strings and email credentials.

# Where the pipeline keeps its files (agol_db.py). All optional; the defaults suit a workstation.
# AGOL_DUCKDB = data/agol.duckdb          the database (DuckDB, one file)
# AGOL_REPORTS_DIR = reports              run folders and report files
# AGOL_CONFIG_DIR = private/config        reviewed lookup tables (department, degree, college-level); organization data
# AGOL_OUTPUT_DIR = data                  built dashboards and their data, read by the web app
# AGOL_ENTRA_INBOX = data/entra-inbox     Entra lookups (.csv + .people.csv) for the daily job to pick up

# ArcGIS Online sign-in for unattended runs: a service account with the administrator role (the organization
# reports need it). Without these, the scripts use the ArcGIS Pro sign-in on the workstation (GIS("home")).
AGOL_URL = https://www.arcgis.com
AGOL_USERNAME =
AGOL_PASSWORD =

# Only for tools/migrate_to_duckdb.py and tools/backfill_history.py: the old SQL Server database.
SQL_CONNECTION_STRING = mssql+pyodbc://@INSERT_SERVERNAME_HERE/AGOLCleanup?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Email credentials for sending notifications. Update the sender email and password as needed.
SENDER_EMAIL =
SENDER_PASSWORD =

SMTP_SERVER =
SMTP_PORT =

# Names for calculated tables in the database. Update these if you want to use different table names for storing delete status information.
DELETE_STATUS_TABLE_NAME = DeleteStatus
WHITELISTED_ENTRAID_GROUPS_TABLE_NAME = Whitelisted_EntraID_Groups

# Storage quota for user content in megabytes. Update this value as needed to set the maximum allowed storage for user content.
USER_STORAGE_QUOTA_MB = 25

# Dry run mode used to test logic of scripts without sending emails. Set this to True to enable dry run mode, which will skip sending emails. Set to False to enable actual email sending.
DRY_RUN = False
# Identity lookup (TAMU_AGOL_EntraID.py). A public-client app registration in your tenant that is
# allowed delegated User.Read.All. The identifier of your tenant can be its primary domain.
ENTRA_TENANT = example.edu
ENTRA_CLIENT_ID =
# Domain NetID-style usernames belong to, and the suffix AGOL adds to SSO usernames
ORG_EMAIL_DOMAIN = example.edu
AGOL_USERNAME_SUFFIX = _example

# TAMU directory lookup (TAMU_AGOL_MQS.py), from mqs.tamu.edu/rest/clients/. Keep real values only in .env.
MQS_CLIENT_ID =
MQS_SHARED_SECRET =

# Web app (web/app.py). Auth0 "Regular Web Application"; callback URL <PUBLIC_URL>/callback, logout URL <PUBLIC_URL>.
AUTH0_DOMAIN =
AUTH0_CLIENT_ID =
AUTH0_CLIENT_SECRET =
# Who gets in: the role (in the ID token claim AUTH_ROLES_CLAIM, added by an Auth0 Action) or an allowed email.
AUTH_ROLES_CLAIM =
AUTH_REQUIRED_ROLE =
AUTH_ALLOWED_EMAILS =
SESSION_SECRET =
PUBLIC_URL =
